# ==============================================================================
# IKA TRAVEL PLATFORM - PLANTILLA DE CONFIGURACIÓN DE PRODUCCIÓN (.env.production)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre '.env.production' en el VPS:
#    cp .env.production.example .env.production
# 2. Reemplaza los valores de ejemplo con tus credenciales reales y seguras.
# 3. NUNCA subas el archivo '.env.production' a Git ni lo compartas públicamente.
# ==============================================================================

# --- Dominio y Certificados SSL Automáticos (Caddy) ---
# Dominio que apunta a la IP de tu VPS (ej. api.ikatravel.pe o tu IP si no tienes dominio)
DOMAIN_NAME=api.ikatravel.pe
EMAIL_NOTIFICACIONES_ADMIN=admin@dircetur.gob.pe

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=ika_usuario
POSTGRES_PASSWORD=CambiarPorContrasenaMuySegura123_!
POSTGRES_DB=ika_travel_bd

# --- Seguridad y JWT ---
# Genera una clave segura de 32 bytes ejecutando en tu terminal: openssl rand -hex 32
CLAVE_SECRETA_JWT=generar_clave_segura_con_openssl_rand_hex_32
ALGORITMO_JWT=HS256
DURACION_TOKEN_MINUTOS=1440

# --- Inteligencia Artificial (Google Gemini) ---
# API Key obtenida de Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODELO=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=8

# --- APIs Meteorológicas Externas ---
# OpenWeatherMap API (https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=tu_openweather_api_key_aqui
# WeatherAPI (https://www.weatherapi.com/)
WEATHERAPI_API_KEY=tu_weatherapi_api_key_aqui

# --- Autenticación con Google (OAuth 2.0) ---
# Web Client ID configurado en Google Cloud Console para validar tokens de la app móvil
GOOGLE_CLIENT_IDS=575307622274-shcaqq8vgqgqitc82rjp43m3ujt7dvg8.apps.googleusercontent.com

# --- Configuración del Clima y Región ---
CLIMA_VIGENCIA_HORAS=3
CLIMA_LATITUD_REGION=-14.0678
CLIMA_LONGITUD_REGION=-75.7286

# --- Notificaciones y Alertas SOS ---
SOS_NOTIFY_EMAILS=admin@dircetur.gob.pe,emergencias@ikatravel.pe

# --- Correo Transaccional (SMTP para restablecimiento de contraseña) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_google
SMTP_FROM=Ika Travel <tu_correo@gmail.com>
SMTP_TIMEOUT_SEGUNDOS=15
PASSWORD_RESET_URL_TEMPLATE=ikatravel://reset-password?token={token}

# --- CORS y Almacenamiento ---
ORIGENES_CORS=*
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=5
CLAVE_ADMIN=cambiar_clave_admin_segura
