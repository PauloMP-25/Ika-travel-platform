URL_BASE_DATOS=postgresql+asyncpg://ika_usuario:ika_contrasena@localhost:5433/ika_travel_bd
# BD de pruebas (pytest); si no existe se usa URL_BASE_DATOS con sufijo _test
# TEST_DATABASE_URL=postgresql+asyncpg://ika_usuario:ika_contrasena@localhost:5433/ika_travel_test

# --- Redis y Celery ---
URL_REDIS=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- APIs Externas ---
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=
GEMINI_API_KEY=
DIRCETUR_URL_PADRON=

# --- Login con Google (Sprint 4) ---
# Lista separada por comas de los client_id aceptados (Android, iOS y web).
GOOGLE_CLIENT_IDS=

# --- SOS ---
SOS_NOTIFY_EMAILS=admin1@ika.com,admin2@ika.com

# --- Traducción (Sprint 3) ---
# TRANSLATION_MODEL=            # si se omite se usa GEMINI_MODELO
TRANSLATION_TIMEOUT_SECONDS=8
TRANSLATION_MAX_CHARS=500
TRANSLATION_CACHE_TTL_SECONDS=604800
TRANSLATION_FALLBACK_TTL_SECONDS=2592000
TRANSLATION_RATE_LIMIT_PER_MINUTE=30

# --- Core ---
ORIGENES_CORS=*
CLAVE_ADMIN=secreto
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Correo transaccional (RF-03: recuperación de cuenta) ---
# Gmail SMTP con STARTTLS. SMTP_USER/SMTP_PASSWORD deben venir del entorno:
# con Gmail se usa una CONTRASEÑA DE APLICACIÓN de Google, jamás la contraseña
# de la cuenta. NO pegues credenciales reales en este archivo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Remitente visible; si se omite se usa SMTP_USER.
SMTP_FROM=
SMTP_TIMEOUT_SEGUNDOS=15
# Única fuente del enlace de recuperación (se abre en la app móvil).
# Debe contener {token}; la cabecera Host NO se usa para construirlo.
PASSWORD_RESET_URL_TEMPLATE=ikatravel://reset-password?token={token}
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Límites de solicitud (RF-03): 5 por IP / 15 min y 3 por correo / hora.
PASSWORD_RESET_MAX_POR_IP=5
PASSWORD_RESET_VENTANA_IP_SEGUNDOS=900
PASSWORD_RESET_MAX_POR_CORREO=3
PASSWORD_RESET_VENTANA_CORREO_SEGUNDOS=3600
