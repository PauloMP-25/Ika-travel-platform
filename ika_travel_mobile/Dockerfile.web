# Imagen de la versión web de Ika Travel: compila con Flutter y sirve el
# resultado estático con Nginx.
#
# La URL del backend se inyecta EN TIEMPO DE COMPILACIÓN (Flutter la congela
# dentro del JavaScript), así que hay que pasarla como build-arg:
#
#   docker build -f ika_travel_mobile/Dockerfile.web \
#     --build-arg API_URL=https://api.ika-travel.camiluxlym.com \
#     -t ika-travel-web .
#
# En Dokploy se configuran como "Build Arguments" en la aplicación.
#
# IMPORTANTE - CONTEXTO DE CONSTRUCCION
# Todas las rutas COPY son relativas a la RAIZ DEL REPOSITORIO, no a esta
# carpeta: es el contexto que usa Dokploy. Con rutas relativas a
# ika_travel_mobile el despliegue fallaba con
#   failed to calculate checksum "/nginx.conf": not found
# Por eso el docker build de arriba tambien se lanza desde la raiz.

# ---------- Etapa 1: compilar ----------
# Se usa el tag "stable" porque el tag de version exacta no existe en el
# registro. Contrapartida: la imagen no queda fijada, asi que una version
# futura de Flutter podria cambiar el resultado de la compilacion. Si eso
# llega a pasar, fijar aqui una version concreta que si exista en
# ghcr.io/cirruslabs/flutter.
FROM ghcr.io/cirruslabs/flutter:stable AS build

ARG API_URL="https://api.ika-travel.camiluxlym.com"
ARG GOOGLE_WEB_CLIENT_ID=""
ARG GEMINI_API_KEY=""
ARG TOMTOM_API_KEY=""

WORKDIR /app

# Las dependencias se resuelven antes de copiar el código: si solo cambia el
# código, Docker reutiliza esta capa y la compilación es mucho más rápida.
COPY ika_travel_mobile/pubspec.yaml ika_travel_mobile/pubspec.lock ./
RUN flutter pub get

COPY ika_travel_mobile/ .

RUN flutter build web --release \
    --dart-define=API_URL="$API_URL" \
    --dart-define=GOOGLE_WEB_CLIENT_ID="$GOOGLE_WEB_CLIENT_ID" \
    --dart-define=GEMINI_API_KEY="$GEMINI_API_KEY" \
    --dart-define=TOMTOM_API_KEY="$TOMTOM_API_KEY"

# ---------- Etapa 2: servir ----------
FROM nginx:1.27-alpine

COPY --from=build /app/build/web /usr/share/nginx/html
COPY ika_travel_mobile/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
