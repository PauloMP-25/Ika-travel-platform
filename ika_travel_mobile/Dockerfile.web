# Imagen de la version web de Ika Travel: compila con Flutter y sirve el
# resultado estatico con Nginx.
#
# CONFIGURACION
# Flutter congela la configuracion EN TIEMPO DE COMPILACION, asi que no sirve
# ponerla como variable de entorno del contenedor: cuando Nginx arranca, el
# JavaScript ya esta compilado. Hay dos formas de pasarla:
#
#   1. Build arguments (si tu Dokploy los ofrece):
#        docker build -f ika_travel_mobile/Dockerfile.web \
#          --build-arg API_URL=https://api.ika-travel.camiluxlym.com \
#          -t ika-travel-web .
#
#   2. Pestana "Environment" de Dokploy: Dokploy vuelca esas variables en un
#      archivo .env en la raiz del contexto, y este Dockerfile lo lee antes
#      de compilar. Es la via para las versiones de Dokploy que no muestran
#      "Build Arguments".
#
# Si ambas estan presentes, manda el .env.
#
# IMPORTANTE - CONTEXTO DE CONSTRUCCION
# Todas las rutas COPY son relativas a la RAIZ DEL REPOSITORIO, no a esta
# carpeta: es el contexto que usa Dokploy. Con rutas relativas a
# ika_travel_mobile el despliegue fallaba con
#   failed to calculate checksum "/nginx.conf": not found

# ---------- Etapa 1: compilar ----------
# Flutter se instala desde el archivo oficial de Google en vez de partir de
# una imagen ya hecha. Motivo: ghcr.io/cirruslabs/flutter no publica ninguna
# version 3.45 o superior (la mas alta es 3.44.0) y su tag "stable" trae
# Dart 3.12.0, que no cumple la restriccion del proyecto:
#
#   The current Dart SDK version is 3.12.0.
#   Because ika_travel_mobile requires SDK version ^3.13.4, version solving failed.
#
# Es la misma version que usa el equipo en local, asi que el contenedor y el
# portatil compilan lo mismo. Para subirla basta cambiar FLUTTER_VERSION por
# otra del manifiesto oficial:
#   https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json
FROM debian:bookworm-slim AS build

# Flutter 3.47.5 incluye Dart 3.13.4, que satisface `sdk: ^3.13.4`.
ARG FLUTTER_VERSION=3.47.5

# git es obligatorio: Flutter lo usa internamente para resolver su version.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
        "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
        -o /tmp/flutter.tar.xz \
    && tar -xJf /tmp/flutter.tar.xz -C /opt \
    && rm /tmp/flutter.tar.xz

ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

# El contenedor corre como root y Flutter desconfia del repositorio git que
# acaba de extraer; sin esto las ordenes fallan con "dubious ownership".
RUN git config --global --add safe.directory /opt/flutter \
    && flutter --version \
    && flutter precache --web

# Valores por defecto, que el .env de Dokploy puede sobreescribir.
ARG API_URL="https://api.ika-travel.camiluxlym.com"
ARG GOOGLE_WEB_CLIENT_ID=""

WORKDIR /app

# Las dependencias se resuelven antes de copiar el codigo: si solo cambia el
# codigo, Docker reutiliza esta capa y la compilacion es mucho mas rapida.
COPY ika_travel_mobile/pubspec.yaml ika_travel_mobile/pubspec.lock ./
RUN flutter pub get

COPY ika_travel_mobile/ .

# El .env que escribe Dokploy con las variables de Environment. Se copia
# junto a pubspec.yaml, que siempre existe, para que el COPY no falle en una
# compilacion local donde no hay .env.
COPY ika_travel_mobile/pubspec.yaml .env* /tmp/entorno/

# AVISO DE SEGURIDAD
# Lo que se pase con --dart-define queda escrito EN CLARO dentro del
# JavaScript publicado: cualquiera lo lee con "ver codigo fuente". Por eso
# aqui solo viajan identificadores publicos: la URL del backend y el client
# ID de Google (que ademas ya figura en web/index.html, de donde lo lee el
# plugin en web). Las claves de Gemini o TomTom NO se inyectan aunque esten
# en el .env: en un sitio publico serian claves regaladas.
RUN set -eu; \
    if [ -f /tmp/entorno/.env ]; then \
        echo "==> Variables tomadas del .env de Dokploy"; \
        set -a; . /tmp/entorno/.env; set +a; \
    else \
        echo "==> Sin .env: se usan los valores por defecto del Dockerfile"; \
    fi; \
    echo "==> API_URL=${API_URL}"; \
    if [ -n "${GOOGLE_WEB_CLIENT_ID}" ]; then \
        echo "==> GOOGLE_WEB_CLIENT_ID: definido"; \
    else \
        echo "==> GOOGLE_WEB_CLIENT_ID: vacio (se usara el de api_config.dart)"; \
    fi; \
    flutter build web --release \
        --dart-define=API_URL="${API_URL}" \
        --dart-define=GOOGLE_WEB_CLIENT_ID="${GOOGLE_WEB_CLIENT_ID}"; \
    rm -rf /tmp/entorno

# ---------- Etapa 2: servir ----------
# El .env se queda en la etapa de compilacion y NO llega a la imagen final:
# aqui solo se copian los archivos ya compilados y la configuracion de Nginx.
FROM nginx:1.27-alpine

COPY --from=build /app/build/web /usr/share/nginx/html
COPY ika_travel_mobile/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
